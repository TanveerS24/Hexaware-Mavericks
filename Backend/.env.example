# ==========================================
# Citizen Call Intelligence Platform Config
# ==========================================

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Database (Supabase PostgreSQL with pgvector)
# Replace your-project-id and your_supabase_db_password_here with your Supabase credentials
DATABASE_HOST=db.your-project-id.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_supabase_db_password_here
DATABASE_NAME=postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_db_password_here@db.your-project-id.supabase.co:5432/postgres

# Security & Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloud AI Configuration (Anthropic Claude / Google Gemini / OpenAI-compatible API)
AI_PROVIDER=claude
AI_API_KEY=your_claude_gemini_or_openai_api_key_here
AI_MODEL=claude-3-5-haiku-20241022
AI_EMBEDDING_MODEL=text-embedding-004
AI_BASE_URL=
ENABLE_MOCK_AI_FALLBACK=true

# Server & Network Ports
API_GATEWAY_PORT=8000
CITIZEN_API_PORT=8001
OFFICER_API_PORT=8003
ADMIN_API_PORT=8004

# CORS Settings (Comma-separated list or "*" for local dev)
CORS_ORIGINS=*

# Geocoding / External API Stubs
GEOCODING_API_KEY=your_geocoding_api_key_here

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
