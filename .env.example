# ==========================================
# Citizen Call Intelligence Platform Config
# ==========================================

# Database (PostgreSQL with pgvector)
# Use "postgres" as host when running inside Docker network, or "localhost" for local machine development
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=grievance_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/grievance_db

# Security & Authentication
JWT_SECRET_KEY=super_secret_jwt_signing_key_change_in_production_9f83a8b27c12
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Ollama AI Configuration (Local host machine Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Server & Network Ports
API_GATEWAY_PORT=8000
CITIZEN_API_PORT=8001
CALLCENTRE_API_PORT=8002
OFFICER_API_PORT=8003
ADMIN_API_PORT=8004
POSTGRES_EXPOSED_PORT=5432

# CORS Settings (Comma-separated list or "*" for local dev)
CORS_ORIGINS=*

# Geocoding / External API Stubs
GEOCODING_API_KEY=dummy_geocoding_key
ENABLE_MOCK_AI_FALLBACK=true

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
